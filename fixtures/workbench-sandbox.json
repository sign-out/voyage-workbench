  "worldLore": {
    "The Great Lamps": {
      "text": "Each lamp marks a safe passage through the remembering sea. An extinguished lamp draws ships toward places erased from every chart."
    }
  },
  "storyStarts": {
    "The Dark Lighthouse": {
      "name": "The Dark Lighthouse",
      "description": "Investigate a lighthouse that went dark during the evening tide.",
      "storyStart": "Rain ticks against the windows of the harbor office. Mara Venn sets a cold brass lantern on your table. \"The offshore lamp went out an hour ago,\" she says. \"Then we heard someone knocking from inside this.\"",

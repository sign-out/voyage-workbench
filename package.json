{
  "name": "voyage-workbench",
  "version": "0.2.12",
  "license": "GPL-2.0-only",
  "private": true,
  "type": "module",
  "main": "build/desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node tools/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/core/*.test.ts hosts/desktop/*.test.ts hosts/provider/*.test.ts apps/workbench/src/*.test.tsx",
    "test:release": "node --test tests/test_map_camera.mjs tests/test_remote_world_list.mjs tests/test_release_artifacts.mjs",
    "test:responsive": "node tools/run-responsive-smoke.mjs",
    "verify:artifacts": "node tools/verify-artifacts.mjs && python3 tools/verify-android-artifacts.py",
    "desktop": "node tools/start-desktop.mjs",
    "android:sync": "python3 tools/android/package_runtime.py && python3 tools/android/package_provider_runtimes.py && python3 tools/android/package_cursor_runtime.py && npm run build && npx cap sync android",
    "android:provider-packs": "python3 tools/android/prototype_provider_packs.py",
    "package:windows": "npm run package:windows:signed",
    "package:windows:signed": "python3 tools/prepare-windows-signing.py && python3 tools/package-desktop-runtime.py && npm run build && electron-builder --win --x64 --config.afterPack=tools/windows-sign-hook.cjs --config.artifactBuildCompleted=tools/windows-sign-hook.cjs",
    "package:linux": "python3 tools/package-desktop-runtime.py && npm run build && electron-builder --linux --x64"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "lucide-react": "^1.16.0",
    "js-sha256": "0.11.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electron/asar": "^4.2.1",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "dev.voyage.workbench",
    "productName": "Voyage Workbench",
    "directories": {
      "output": "releases"
    },
    "files": [
      "build/desktop/**",
      "!build/desktop/**/*.map",
      "dist/**",
      "!node_modules/**",
      "!**/*.map",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "dir"
      ],
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": ".desktop-runtime/windows",
          "to": "provider"
        }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Office",
      "extraResources": [
        {
          "from": ".desktop-runtime/linux",
          "to": "provider"
        }
      ]
    },
    "icon": "assets/icon.png"
  },
  "description": "A local workspace for building and reviewing Voyage worlds",
  "author": "Voyage Workbench"
}
